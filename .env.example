# Backend origin (used for images, AI chat WS, etc.)
# Local dev:
NEXT_PUBLIC_BACKEND_URL=http://localhost:3007
# Production (Hostinger VPS, backend published on host port 5002):
# NEXT_PUBLIC_BACKEND_URL=http://<VPS_IP_OR_DOMAIN>:5002

# Optional overrides - default to derived values from NEXT_PUBLIC_BACKEND_URL above
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3007/graphql
# NEXT_PUBLIC_WS_URL=ws://localhost:3007/graphql
# NEXT_PUBLIC_WS_CHAT_URL=ws://localhost:3007/ws/chat
